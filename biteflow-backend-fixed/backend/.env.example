# Server
PORT=5000
NODE_ENV=development

# Client (used for CORS allow-list)
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/biteflow

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Cloudinary (optional — leave blank to fall back to local disk storage in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
